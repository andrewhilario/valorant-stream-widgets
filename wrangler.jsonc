{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valorant-stream-widgets",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "valwidgets.live",
      "custom_domain": true
    },
    {
      "pattern": "www.valwidgets.live",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "valorant-stream-widgets"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Anonymous event counts (src/lib/events.ts). The dataset is created by the first write; nothing to set up by hand.
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "tally_events"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://valwidgets.live"
  }
}