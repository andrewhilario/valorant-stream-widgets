{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valorant-stream-widgets",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "valwidgets.live",
      "custom_domain": true
    },
    {
      "pattern": "www.valwidgets.live",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "valorant-stream-widgets"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Anonymous event counts (src/lib/events.ts) are written to a Workers Analytics Engine dataset through a binding called EVENTS.
  // Cloudflare refuses to deploy a Worker with that binding (error 10089, "You need to enable Analytics Engine") until Analytics
  // Engine has been switched on once for the account: dashboard, Workers & Pages, Analytics Engine, Set up, Enable. Until then the
  // binding is left out, and /api/e checks each event and drops it (it answers `x-counted: no`). To start counting, enable it,
  // then add this back above "vars" and push; the dataset is created by the first write.
  //
  //   "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "tally_events" }],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://valwidgets.live"
  }
}