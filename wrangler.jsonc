{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valorant-stream-widgets",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "valwidgets.live",
      "custom_domain": true
    },
    {
      "pattern": "www.valwidgets.live",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "valorant-stream-widgets"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Anonymous event counts (src/lib/events.ts) go to this Workers Analytics Engine dataset. A Cloudflare account has to switch
  // Analytics Engine on once before it will deploy a Worker with this binding (error 10089, "You need to enable Analytics Engine").
  // Here that was done in the dashboard: Storage & databases, Analytics Engine, Create Dataset (name tally_events, binding EVENTS).
  // Without the binding, /api/e checks each event and drops it (it answers `x-counted: no`).
  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "tally_events"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://valwidgets.live"
  }
}