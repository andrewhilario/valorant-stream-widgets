# Copy this file to .env.local. Nothing here is required to run the site locally.
#
# There is no data key to set. Every streamer brings their own free HenrikDev
# key; it stays in their browser and their OBS link, and goes straight to
# HenrikDev. This server never sees it.

# SET THIS BEFORE DEPLOYING. The public address of the site, with no trailing slash, e.g. https://tally.example
# Canonical links, the sitemap, structured data and social cards are built from it. Left empty, they point at
# http://localhost:3000 and `npm run build` warns you. On Vercel the production URL is picked up for you.
NEXT_PUBLIC_SITE_URL=localhost:3000

# Optional. Your Buy Me a Coffee page. Defaults to https://buymeacoffee.com/ainzzuu
NEXT_PUBLIC_BMC_URL=https://buymeacoffee.com/ainzzuu

# Optional. Set to "off" to remove Buy Me a Coffee's floating button (the plain links stay). It is a third-party
# script on pages that hold a streamer's key, so a fork may prefer not to ship it. See README, "Security".
NEXT_PUBLIC_BMC_WIDGET=
