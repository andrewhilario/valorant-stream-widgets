{
  "name": "valorant-stream-widgets",
  "version": "0.1.0",
  "private": true,
  "description": "Free, account-free stream widgets. Customise, copy one link, paste it into OBS.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:api": "node scripts/check-api.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.147.0"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4"
  ]
}
