# Cloudflare Workers static assets: https://developers.cloudflare.com/workers/static-assets/headers/
#
# Everything under /_next/static has a content hash in its name, so a changed file gets a new address and a cached copy never
# goes stale. Without this the files are served with max-age=0, and every repeat visit asks Cloudflare about each one again.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
